{
  "name": "retailpulse-korea",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --experimental-sqlite --import tsx --test tests/contracts.test.ts tests/security.test.ts tests/migrations.test.mjs tests/collector.test.mjs tests/sources.test.mjs tests/airport-today.test.mjs tests/airport-t2-forecast.test.mjs tests/production-runner.test.mjs tests/hybrid.test.ts tests/product-signals.test.ts tests/realtime-dispatch.test.ts",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install --with-deps chromium",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:list": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --list",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .playwright-browsers",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "secret:scan": "node scripts/secret-scan.mjs",
    "validate:production-env": "node scripts/validate-production-env.mjs",
    "validate:cloudflare-env": "node scripts/validate-cloudflare-environment.mjs",
    "build:production": "npm run validate:production-env && npm run build",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "deploy:production": "npm run deploy:cloudflare",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging --config wrangler.production.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production --config wrangler.production.jsonc",
    "collect:production": "tsx scripts/collect-production.ts",
    "cf:typegen": "wrangler types --config wrangler.production.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "KORETAIL"
}

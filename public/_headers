# Cache-Control for everything the Worker serves as a static asset.
#
# This file exists because vinext generates a _headers covering /assets/* only
# — and it skips generation entirely when one is already present, so owning it
# here is the supported way to add rules. Everything NOT under /assets/ was
# therefore being served with Cloudflare's default for Workers assets, which
# revalidates on every visit: a round trip per font, per icon, on every page
# view, on the LTE connection this product is actually read over.

# Build output carries a content hash in its name, so a byte change is a name
# change and the old name can never be wrong.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts live under stable names, so they must NOT be immutable. The Korean
# shell face is a subset generated from the product's own copy (see the
# @font-face comment in app/globals.css): add a word to the UI and the file
# changes while its name does not, and an immutable year would leave returning
# readers with tofu until 2027. A week removes the per-visit revalidation
# without letting a stale face live long, and stale-while-revalidate means the
# refresh never blocks a paint.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# App icons and the manifest change only when the brand does.
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/icon-maskable-512.png
  Cache-Control: public, max-age=604800
/manifest.webmanifest
  Cache-Control: public, max-age=86400

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "retailpulse-korea",
  "account_id": "2848bf4ae7af3c6fde4e26b55b19d0c2",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "development",
    "ENABLE_BETA_SIGNUPS": "false"
  },
  "env": {
    "staging": {
      "name": "retailpulse-korea-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "ENABLE_BETA_SIGNUPS": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "retailpulse-korea-staging",
          "database_id": "00000000-0000-4000-8000-000000000001",
          "migrations_dir": "drizzle"
        }
      ]
    },
    "production": {
      "name": "retailpulse-korea-production",
      "workers_dev": true,
      "triggers": {
        "crons": ["7,22,37,52 * * * *", "42 * * * *"]
      },
      "vars": {
        "APP_ENV": "production",
        "ENABLE_BETA_SIGNUPS": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "retailpulse-korea-production",
          "database_id": "a86b7e71-ddd8-4677-a65d-aa11490c578c",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
